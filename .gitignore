#############################################
# IDEs & Editors (Catch-all for subfolders)
#############################################
# Ігнорує налаштування Rider/IntelliJ у всіх папках
**/.idea/
*.sln.iml
*.idea

# Ігнорує налаштування VS Code у всіх папках
**/.vscode/
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json

#############################################
# General / OS
#############################################
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.bak
*.log

#############################################
# Backend: .NET API (Portfolio)
#############################################
**/bin/
**/obj/
**/publish/
# Секрети та локальні налаштування
**/appsettings.Development.json
**/appsettings.local.json
**/secrets.json

#############################################
# Frontend: Angular (Portfolio-Client)
#############################################
# Залежності (ОБОВ'ЯЗКОВО для Vercel)
**/node_modules/
# Результати збірки та кеш
**/dist/
**/.angular/
# Логи npm
npm-debug.log*
yarn-debug.log*

#############################################
# Database / Local Secrets
#############################################
*.db
*.local.connection
.env
.env.*
!.env.example